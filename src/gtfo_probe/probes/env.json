{
  "probes": [
    {
      "id": "env.print.control",
      "tool": "env",
      "argv": [],
      "expect": [],
      "description": "CONTROL: plain `env` just prints the environment."
    },
    {
      "id": "env.set-var.control",
      "tool": "env",
      "argv": [
        "-i",
        "FOO=1"
      ],
      "expect": [],
      "description": "CONTROL: `env -i FOO=1` with no command prints the new environment and runs nothing.",
      "flag": "-i"
    },
    {
      "id": "env.runner",
      "tool": "env",
      "argv": [
        "<<canary_exec>>"
      ],
      "expect": [
        "exec"
      ],
      "description": "BY DESIGN: `env COMMAND` runs COMMAND.",
      "flag": "",
      "tags": [
        "runner"
      ]
    },
    {
      "id": "env.split-string",
      "tool": "env",
      "argv": [
        "-S",
        "<<canary_exec>> a b"
      ],
      "expect": [
        "exec"
      ],
      "description": "`-S STRING` splits STRING into a command and arguments (what makes `#!/usr/bin/env -S` work) and runs it.",
      "flag": "-S",
      "tags": [
        "runner"
      ]
    },
    {
      "id": "env.split-string-abbrev",
      "tool": "env",
      "argv": [
        "--split=<<canary_exec>> a"
      ],
      "expect": [
        "exec"
      ],
      "description": "`--split=` (prefix of --split-string) works the same.",
      "flag": "--split",
      "tags": [
        "runner"
      ]
    },
    {
      "id": "env.chdir",
      "tool": "env",
      "argv": [
        "--chdir=<<data>>",
        "<<canary_exec>>"
      ],
      "expect": [
        "exec"
      ],
      "description": "`--chdir=DIR` changes directory and then runs the command.",
      "flag": "--chdir",
      "tags": [
        "runner"
      ]
    }
  ]
}
